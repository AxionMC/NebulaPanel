#!/usr/bin/env bash
#
# NebulaPanel 管理命令行 (npctl)
# 用于管理 NebulaPanel 面板服务的启停、配置和维护
#
# 用法：
#   npctl <command> [args]
#
# 命令：
#   start [core|agent|all]    启动服务
#   stop  [core|agent|all]    停止服务
#   restart [core|agent|all]  重启服务
#   status [core|agent|all]   查看服务状态
#   enable [core|agent|all]   设置开机自启
#   disable [core|agent|all]  取消开机自启
#   update password           修改管理员密码
#   update username           修改管理员账号
#   update port <port>        修改面板端口
#   user-info                 查看访问信息
#   reset entrance            重置安全入口
#   reset https               关闭 HTTPS
#   reset ips                 清空 IP 白名单
#   reset domain              清空绑定域名
#   reset mfa                 关闭 MFA
#   reset passkey             清除 Passkey
#   version                   显示版本
#   help                      显示帮助
#

set -euo pipefail

NP_CTL_FILE="$(readlink -f "$0" 2>/dev/null || echo "$0")"
NP_CORE_BIN="/usr/local/bin/NebulaPanel-core"
NP_AGENT_BIN="/usr/local/bin/NebulaPanel-agent"
NP_SERVICE_CORE="nebulapanel-core.service"
NP_SERVICE_AGENT="nebulapanel-agent.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()  { printf "${BLUE}[INFO]${NC} %s\n" "$*"; }
ok()    { printf "${GREEN}[OK]${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}[WARN]${NC} %s\n" "$*"; }
error() { printf "${RED}[ERROR]${NC} %s\n" "$*" >&2; }

###############################################################################
# 读取 npctl 配置键值
###############################################################################
npctl_get_config() {
    local key="$1"
    if [ -f "$NP_CTL_FILE" ]; then
        grep -E "^${key}=" "$NP_CTL_FILE" 2>/dev/null | head -1 | cut -d'=' -f2- || true
    fi
}

npctl_set_config() {
    local key="$1" value="$2"
    if [ -f "$NP_CTL_FILE" ]; then
        if grep -q "^${key}=" "$NP_CTL_FILE"; then
            sed -i "s/^${key}=.*/${key}=${value}/" "$NP_CTL_FILE"
        else
            echo "${key}=${value}" >> "$NP_CTL_FILE"
        fi
    fi
}

###############################################################################
# 获取安装目录和端口
###############################################################################
get_install_dir() {
    local d
    d="$(npctl_get_config BASE_DIR)"
    [ -z "$d" ] && d="/opt"
    echo "$d"
}

get_port() {
    local p
    p="$(npctl_get_config ORIGINAL_PORT)"
    [ -z "$p" ] && p="9999"
    echo "$p"
}

get_entrance() {
    local e
    e="$(npctl_get_config ORIGINAL_ENTRANCE)"
    [ -z "$e" ] && e="nebula"
    echo "$e"
}

###############################################################################
# 服务操作
###############################################################################
svc_action() {
    local action="$1" target="$2"
    local svcs=()
    case "$target" in
        core|"") svcs+=("$NP_SERVICE_CORE") ;;
        agent)   svcs+=("$NP_SERVICE_AGENT") ;;
        all)     svcs+=("$NP_SERVICE_CORE" "$NP_SERVICE_AGENT") ;;
        *) error "未知目标：$target（支持：core、agent、all）"; return 1 ;;
    esac

    for svc in "${svcs[@]}"; do
        if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
            systemctl "$action" "$svc" 2>&1 || true
        else
            warn "服务 $svc 未安装，跳过"
        fi
    done
}

cmd_start()    { svc_action start "${1:-all}"; }
cmd_stop()     { svc_action stop  "${1:-all}"; }
cmd_restart()  { svc_action restart "${1:-all}"; }
cmd_enable()   { svc_action enable "${1:-all}"; }
cmd_disable()  { svc_action disable "${1:-all}"; }

cmd_status() {
    local target="${1:-all}"
    local svcs=()
    case "$target" in
        core|"") svcs+=("$NP_SERVICE_CORE") ;;
        agent)   svcs+=("$NP_SERVICE_AGENT") ;;
        all)     svcs+=("$NP_SERVICE_CORE" "$NP_SERVICE_AGENT") ;;
        *) error "未知目标：$target"; return 1 ;;
    esac
    for svc in "${svcs[@]}"; do
        if systemctl list-unit-files "$svc" >/dev/null 2>&1; then
            systemctl status "$svc" --no-pager 2>&1 || true
        else
            warn "服务 $svc 未安装"
        fi
    done
}

###############################################################################
# 配置修改
###############################################################################
cmd_update_password() {
    if [ "$(id -u)" -ne 0 ]; then
        error "请使用 root 权限运行：sudo npctl update password"
        return 1
    fi
    if [ -x "$NP_CORE_BIN" ]; then
        "$NP_CORE_BIN" update password --username "" 2>&1 || true
    else
        error "未找到 NebulaPanel-core 二进制：$NP_CORE_BIN"
        return 1
    fi
}

cmd_update_username() {
    if [ "$(id -u)" -ne 0 ]; then
        error "请使用 root 权限运行：sudo npctl update username"
        return 1
    fi
    if [ -x "$NP_CORE_BIN" ]; then
        "$NP_CORE_BIN" update username --username "" 2>&1 || true
    else
        error "未找到 NebulaPanel-core 二进制：$NP_CORE_BIN"
        return 1
    fi
}

cmd_update_port() {
    local new_port="${1:-}"
    if [ -z "$new_port" ]; then
        error "用法：npctl update port <port>"
        return 1
    fi
    if [ "$(id -u)" -ne 0 ]; then
        error "请使用 root 权限运行：sudo npctl update port $new_port"
        return 1
    fi
    if [ -x "$NP_CORE_BIN" ]; then
        # 先更新 npctl 配置文件
        npctl_set_config ORIGINAL_PORT "$new_port"
        # 调用 core 二进制更新数据库
        echo "$new_port" | "$NP_CORE_BIN" update port 2>&1 || true
        # 重启服务使端口生效
        systemctl restart nebulapanel-core.service 2>&1 || true
        ok "面板端口已更新为 $new_port，服务已重启"
    else
        error "未找到 NebulaPanel-core 二进制：$NP_CORE_BIN"
        return 1
    fi
}

cmd_user_info() {
    if [ -x "$NP_CORE_BIN" ]; then
        "$NP_CORE_BIN" user-info 2>&1 || true
    else
        error "未找到 NebulaPanel-core 二进制：$NP_CORE_BIN"
        return 1
    fi
}

###############################################################################
# 重置操作
###############################################################################
cmd_reset() {
    local sub="${1:-}"
    if [ -z "$sub" ]; then
        error "用法：npctl reset <entrance|https|ips|domain|mfa|passkey>"
        return 1
    fi
    if [ "$(id -u)" -ne 0 ]; then
        error "请使用 root 权限运行：sudo npctl reset $sub"
        return 1
    fi
    if [ ! -x "$NP_CORE_BIN" ]; then
        error "未找到 NebulaPanel-core 二进制：$NP_CORE_BIN"
        return 1
    fi

    case "$sub" in
        entrance)  "$NP_CORE_BIN" reset entrance 2>&1 || true ;;
        https)     "$NP_CORE_BIN" reset https 2>&1 || true ;;
        ips)       "$NP_CORE_BIN" reset ips 2>&1 || true ;;
        domain)    "$NP_CORE_BIN" reset domain 2>&1 || true ;;
        mfa)       "$NP_CORE_BIN" reset mfa 2>&1 || true ;;
        passkey)   "$NP_CORE_BIN" reset passkey 2>&1 || true ;;
        *) error "未知重置项：$sub（支持：entrance https ips domain mfa passkey）"; return 1 ;;
    esac
}

###############################################################################
# 版本与帮助
###############################################################################
cmd_version() {
    local ver
    ver="$(npctl_get_config ORIGINAL_VERSION)"
    [ -z "$ver" ] && ver="V1.0.0"
    echo "NebulaPanel 管理 CLI (npctl)"
    echo "版本：$ver"
}

cmd_help() {
    cat <<EOF
NebulaPanel 管理命令行 (npctl)

用法：
  npctl <command> [args]

命令：
  start [core|agent|all]    启动服务（默认 all）
  stop  [core|agent|all]    停止服务（默认 all）
  restart [core|agent|all]  重启服务（默认 all）
  status [core|agent|all]   查看服务状态（默认 all）
  enable [core|agent|all]   设置开机自启（默认 all）
  disable [core|agent|all]  取消开机自启（默认 all）
  update password           修改管理员密码
  update username           修改管理员账号
  update port <port>        修改面板端口
  user-info                 查看访问信息
  reset entrance            重置安全入口
  reset https               关闭 HTTPS
  reset ips                 清空 IP 白名单
  reset domain              清空绑定域名
  reset mfa                 关闭 MFA
  reset passkey             清除 Passkey 凭证
  version                   显示版本信息
  help                      显示此帮助

示例：
  npctl restart core        # 仅重启核心面板服务
  npctl update port 8080    # 将面板端口改为 8080
  npctl user-info           # 查看面板访问地址和账号
  npctl status all          # 查看所有服务状态
EOF
}

###############################################################################
# 入口
###############################################################################
main() {
    local cmd="${1:-help}"
    shift || true
    case "$cmd" in
        start)     cmd_start "$@" ;;
        stop)      cmd_stop "$@" ;;
        restart)   cmd_restart "$@" ;;
        status)    cmd_status "$@" ;;
        enable)    cmd_enable "$@" ;;
        disable)   cmd_disable "$@" ;;
        update)    local sub="${1:-}"; shift || true;
                   case "$sub" in
                       password) cmd_update_password ;;
                       username) cmd_update_username ;;
                       port)     cmd_update_port "$@" ;;
                       *) error "未知 update 子命令：$sub（支持：password username port）"; return 1 ;;
                   esac ;;
        user-info) cmd_user_info ;;
        reset)     cmd_reset "$@" ;;
        version)   cmd_version ;;
        help|--help|-h) cmd_help ;;
        *) error "未知命令：$cmd，输入 'npctl help' 查看用法"; return 1 ;;
    esac
}

main "$@"
